{
  "name": "pepkio-mendelian-cross-solver",
  "version": "0.1.1",
  "description": "Call the Pepkio Mendelian Cross Solver REST API from Node.js with typed ESM imports and a CLI.",
  "license": "MIT",
  "author": "Pepkio Team",
  "homepage": "https://www.pepkio.com/tools/mendelian-cross-solver",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-mendelian-cross-solver-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-mendelian-cross-solver-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "keywords": [
    "genetics",
    "punnett-square",
    "mendelian",
    "education",
    "mendelian-cross-solver",
    "pepkio",
    "genotype",
    "phenotype",
    "abo-blood-type",
    "sex-linked",
    "codominance",
    "incomplete-dominance",
    "bioinformatics",
    "life-sciences",
    "typescript",
    "node",
    "rest-api",
    "scientific-computing"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-mendelian-cross-solver": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run test/client.test.ts",
    "test:integration": "vitest run test/integration.test.ts",
    "test:all": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "undici": "^7.27.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dotenv": "^16.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "readme": "README_NPM.md"
}
